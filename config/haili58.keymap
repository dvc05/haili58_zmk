#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < ... >; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < ... >; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3   &kp NUMBER_4  &kp NUMBER_5        &kp NUMBER_6    &kp N7      &kp N8     &kp N9   &kp N0     &kp BACKSPACE
&kp TAB           &kp Q         &kp W         &kp F          &kp P         &kp B               &kp J           &kp L       &kp U      &kp Y    &kp SEMI   &kp 
&kp BACKSPACE     &kp A         &kp R         &kp S          &kp T         &kp G               &kp M           &kp N       &kp E      &kp I    &kp O      &mt LBKT SQT
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C          &kp D         &kp V               &kp K           &kp MH      &kp COMMA  &kp DOT  &kp FSLH   &kp ENTER
&kp LEFT_ALT      &kp LEFT_GUI  &kp SPACE     &kp RIGHT_ALT  &mo 1         &studio_unlock      &studio_unlock  &kp DELETE  &mo 1      &mo 2    &kp MINUS  &kp EQUAL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_NEXT C_PREV>;
        };

        layer_1 {
            bindings = <
&kp GRAVE  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5      &kp F6  &kp F7    &kp F8    &kp F9     &kp F10  &trans
&trans     &kp F11  &kp F12  &trans  &trans  &trans      &trans  &trans    &kp UP    &trans     &trans   &kp RBKT
&trans     &trans   &trans   &trans  &trans  &trans      &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans   &kp DOUBLE_QUOTES
&trans     &trans   &trans   &trans  &trans  &trans      &trans  &trans    &trans    &trans     &trans   &trans
&trans     &trans   &trans   &trans  &trans  &trans      &trans  &trans    &trans    &trans     &trans   &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans           &trans       &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp INS  &kp HOME         &kp PAGE_UP  &kp PAGE_DOWN  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &kp END  &kp PRINTSCREEN  &trans       &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans           &trans       &trans         &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans           &trans       &trans         &trans  &trans
            >;
        };
    };
};
