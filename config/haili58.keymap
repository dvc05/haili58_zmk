#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                 6  7  8  9 10 11
                18 19 20 21 22 23
                30 31 32 33 34 35
                42 43 44 45 46 47
                54 55 56 57 58 59
            >;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                 0  1  2  3  4  5
                12 13 14 15 16 17
                24 25 26 27 28 29
                36 37 38 39 40 41
                48 49 50 51 52 53
            >;
            hold-trigger-on-release;
        };
    };
    macros {
        screen_left: screen_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LGUI &kp LCTRL>
                , <&macro_tap &kp LEFT>
                , <&macro_release &kp LGUI &kp LCTRL>
                ;
        };

        screen_right: screen_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LGUI &kp LCTRL>
                , <&macro_tap &kp RIGHT>
                , <&macro_release &kp LGUI &kp LCTRL>
                ;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC           &mkp MB4      &mkp MB3      &mkp MB2       &mkp MB1      &mkp MB5            &kp LS(N1)          &kp LS(MINUS)   &kp LS(N2)     &kp LS(N6)   &kp LS(N0)  &kp NUBS
&kp TAB           &kp Q         &kp W         &kp F          &kp P         &kp B               &kp J               &kp L           &kp U          &kp Y        &kp SEMI    &kp LBKT
&kp BACKSPACE     &kp A         &hml LALT R   &hml LSHFT S   &hml LCTRL T  &kp G               &kp M               &hmr LCTRL N    &hmr LSHFT E   &hmr LALT I  &kp O       &kp APOS
&kp LCTRL         &kp Z         &kp X         &kp C          &kp D         &kp V               &kp K               &kp H           &kp COMMA      &kp DOT      &kp FSLH    &kp MINUS
&screen_left      &mo 2         &mo 1         &kp RIGHT_ALT  &mo 1         &kp C_MUTE          &kp C_PLAY_PAUSE    &kp DELETE      &kp CAPS       &kp SPACE    &kp RETURN  &kp LGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_NEXT C_PREV>;
        };

        layer_1 {
            bindings = <
&kp GRAVE      &kp F1           &kp F2           &kp F3          &kp F4          &kp F5          &kp F6      &kp F7    &kp F8    &kp F9     &kp F10          &trans
&trans         &kp F11          &kp F12          &kp RA(N8)      &kp RA(N9)      &kp EQUAL       &kp RBKT    &kp N7    &kp N8    &kp N9     &kp LS(BSLH)     &kp BSLH
&kp RA(N2)     &kp LS(N3)       &kp RA(N4)       &kp LS(N8)      &kp LS(N9)      &trans          &trans      &kp N4    &kp N5    &kp N6     &kp MINUS        &kp LS(N7)
&trans         &kp LS(N5)       &kp RBKT         &kp RA(N7)      &kp RA(N0)      &trans          &trans      &kp N1    &kp N2    &kp N3     &kp SLASH        &kp LS(N0)
&screen_right  &trans           &trans           &trans          &trans          &trans          &trans      &trans    &trans    &trans     &kp DOT          &kp N0
            >;
        };

        layer_2 {
            bindings = <
&studio_unlock  &trans          &trans      &trans          &trans      &trans          &trans   &trans           &trans           &trans         &trans      &trans
&trans          &trans          &trans      &trans          &trans      &trans          &trans   &kp HOME         &kp PAGE_DOWN    &kp PAGE_UP    &kp END     &trans
&trans          &trans          &trans      &trans          &trans      &trans          &trans   &kp LEFT         &kp DOWN         &kp UP         &kp RIGHT   &trans
&trans          &kp C_AL_CALC   &kp K_CALC  &kp PSCRN       &trans      &trans          &trans   &trans           &trans           &trans         &trans      &trans
&trans          &trans          &trans      &trans          &trans      &trans          &trans   &trans           &trans           &trans         &trans      &trans
            >;
        };
    };
};
